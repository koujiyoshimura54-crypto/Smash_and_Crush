      "--Responsible for regening a player's humanoid's health",
      "function regenHealth()",
      "\twhile Humanoid.Health < Humanoid.MaxHealth do",
      "\t\tlocal health = Humanoid.Health",
      "\t\tif health > 0 and health < Humanoid.MaxHealth then",
      "\t\t\tlocal newHealthDelta = 0.01 * s * Humanoid.MaxHealth",
      "\t\t\thealth = health + newHealthDelta",
      "\t\t\tHumanoid.Health = math.min(health,Humanoid.MaxHealth)",
      "\tif Humanoid.Health > Humanoid.MaxHealth then",
      "\t\tHumanoid.Health = Humanoid.MaxHealth",
      "Humanoid.HealthChanged:connect(regenHealth)"
    ]
